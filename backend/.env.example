APP_NAME="Raj ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
ERP_VERSION=development
ERP_BUILD_IDENTIFIER=
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=raj_erp
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000,127.0.0.1:3000,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SANCTUM_EXPIRATION=120

# Password reset / transactional email. Production must use smtp (or another real mailer), not log.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Vimawallah ERP"

ADMIN_NAME="Development Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
ADMIN_TENANT_ID=00000000-0000-4000-8000-000000000001

OCR_SPACE_API_KEY=
OCR_SPACE_CA_BUNDLE=
PADDLEOCR_URL=http://127.0.0.1:8081
PADDLEOCR_TIMEOUT=100
PADDLEOCR_PUBLIC_TOKEN=

# Internal Bug Agent (screenshot triage + developer diagnosis)
OPENAI_API_KEY=
BUG_AGENT_MODEL=gpt-5.6-terra
