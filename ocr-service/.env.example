OCR_SERVICE_NAME=vimawallah-ocr
OCR_HOST=0.0.0.0
OCR_PORT=8001
OCR_LOG_LEVEL=INFO

# 15 MiB total across front/back/combined.
OCR_MAX_UPLOAD_BYTES=15728640
OCR_MAX_IMAGE_PIXELS=40000000
OCR_PREPROCESSING_MAX_SIDE=2600
OCR_REQUEST_TIMEOUT_SECONDS=90
OCR_MIN_FIELD_CONFIDENCE=0.55

OCR_CPU_THREADS=2
OCR_MODEL_CACHE_DIR=/models
OCR_ENABLE_DOCUMENT_ORIENTATION=true
OCR_TEXT_DETECTION_MODEL_NAME=PP-OCRv5_mobile_det
OCR_TEXT_RECOGNITION_MODEL_NAME=PP-OCRv5_mobile_rec

# oneDNN/MKLDNN is disabled for the production CPU compatibility path.
FLAGS_use_mkldnn=0

# Comma-separated exact origins. Leave empty when browser access is not needed.
OCR_CORS_ALLOWED_ORIGINS=
OCR_CORS_ALLOW_CREDENTIALS=false
